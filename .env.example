# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Server
PORT=3000
FRONTEND_URL=http://localhost:5173

# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string

# Encrypts provider refresh tokens before they reach MongoDB. Exactly 64 hex chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this makes every stored token unreadable and forces users to reconnect.
ENCRYPTION_KEY=

# MongoDB. An Atlas SRV string works as-is; the database name is separate.
MONGODB_URI=
MONGODB_DB_NAME=user_dashboard

# How often the scheduler checks for users whose local delivery hour has arrived.
# The hour itself is per user, set in Settings, so this is not "07:00" any more.
SUMMARY_CRON=*/15 * * * *

# --- Starting values for newly created accounts. Each is editable in Settings. ---
SUMMARY_LANGUAGE=Hebrew
# Defaults to the host timezone when empty, e.g. Asia/Jerusalem
TIMEZONE=
# Local hour to deliver the briefing.
SUMMARY_HOUR=7
# Weekly distance target in km. 0 means "just report totals".
ACTIVITY_WEEKLY_GOAL_KM=0

# Caching. Google results are reused for this long across dashboard requests,
# and manual regeneration is limited to once per interval.
DASHBOARD_CACHE_TTL_SECONDS=90
SUMMARY_MIN_REFRESH_SECONDS=60

# How often saved stock/fund price alerts are checked while the dashboard is closed.
WATCHLIST_CRON=*/5 * * * *

# --- Provider credentials for the deployment. Blank means the app cannot offer
# --- that integration at all; users then connect their own account per provider.

# OpenWeatherMap. A free key covers the endpoints used here (current + 5day/3h);
# One Call 3.0 is a separate paid subscription and is not used.
# Users can pin their own coordinates in Settings; these two are the fallback
# so the header chip still has data before anyone has set a pin.
OPENWEATHER_API_KEY=
WEATHER_LAT=
WEATHER_LON=

# Notion PUBLIC OAuth integration from notion.so/my-integrations — not an internal
# integration secret. Each user authorises it and then picks their own databases,
# so no database ids belong here.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:3000/auth/notion/callback

# Strava, an alternative activity source, dormant while blank. Requires a paid
# Strava subscription as of June 2026, and Notion takes priority if a user has both.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3000/auth/strava/callback
